{
	"name": "UNIC-CASS IC Design Tools for Linux",
	"image": "isaiassh/unic-cass-tools:1.3.0",
	"remoteUser": "designer",
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/designer/shared,type=bind",
	"workspaceFolder": "/foss/designs",
	"features": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"barakh.vscode-xschem-viewer",
				"charliermarsh.ruff"
			],
			"settings": {
				"[python]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "charliermarsh.ruff"
				}
			}
		}
	},
	"updateRemoteUserUID": true,
	"mounts": [
		{
			"source": "/tmp/.X11-unix",
			"target": "/tmp/.X11-unix",
			"type": "bind"
		},
		{
			"source": "/home/${localEnv:USER}/.Xauthority",
			"target": "/tmp/.Xauthority",
			"type": "bind"
		}
	],
	"containerEnv": {
		"SHELL": "/bin/bash",
		"PDK": "ihp-sg13g2",
		"DISPLAY": "${localEnv:DISPLAY}",
		"XAUTHORITY": "/tmp/.Xauthority",
		"LIBGL_ALWAYS_INDIRECT": "1"
	}
}