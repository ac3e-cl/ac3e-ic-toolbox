{
	"name": "UNIC-CASS IC Design Tools for WSL",
	"image": "isaiassh/unic-cass-tools:1.3.0",
	"remoteUser": "designer",
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/designer/shared,type=bind",
	"workspaceFolder": "/foss/designs",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"barakh.vscode-xschem-viewer",
				"charliermarsh.ruff"
			],
			"settings": {
				"[python]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "charliermarsh.ruff"
				}
			}
		}
	},
	"mounts": [
		{
			"source": "\\\\wsl.localhost\\${localEnv:WSL_DISTRO}\\tmp\\.X11-unix",
			"target": "/tmp/.X11-unix",
			"type": "bind"
		},
		{
			"source": "\\\\wsl.localhost\\${localEnv:WSL_DISTRO}\\tmp\\wslg",
			"target": "/mnt/wslg",
			"type": "bind"
		}
	],
	"containerEnv": {
		"SHELL": "/bin/bash",
		"PDK": "ihp-sg13g2",
		"DISPLAY": ":0",
		"LIBGL_ALWAYS_INDIRECT": "1",
		"XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
		"WAYLAND_DISPLAY": "wayland-0",
		"PULSE_SERVER": "unix:/mnt/wslg/PulseServer"
	}

}