{
	"name": "UNIC-CASS IC Design Tools for Windows",
	"image": "isaiassh/unic-cass-tools:1.3.0",
	"remoteUser": "designer",
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/designer/shared,type=bind",
	"workspaceFolder": "/foss/designs",
	"features": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"barakh.vscode-xschem-viewer",
				"charliermarsh.ruff"
			],
			"settings": {
				"[python]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "charliermarsh.ruff"
				}
			}
		}
	},
	"updateRemoteUserUID": true,
	"containerEnv": {
		"SHELL": "/bin/bash",
		"PDK": "ihp-sg13g2",
		"DISPLAY": "host.docker.internal:0",
		"LIBGL_ALWAYS_INDIRECT": "1"
	}
}