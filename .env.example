# Local workstation settings. Copy to .env or let the first start create it.
# Literal KEY=value only; shell expressions and variable expansion are not supported.
# Leave empty to choose interactively on first start (default: repository shared/).
SHARED_DIR=

# Optional overrides:
# PDK=ihp-sg13g2
# DOCKER_TAG=0.1.0
# MAX_BUILD_JOBS=2
# BUILD_VERBOSE=1
# BUILDKIT_PROGRESS=plain
# BUILD_MAX_PARALLELISM=2
# BUILD_BUILDER=ac3e-ic-toolbox-p2
