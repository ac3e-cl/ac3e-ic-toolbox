# Copy to .env. Literal KEY=value only; optional matching single/double quotes.
# No shell expansion, commands, export, multiline values or inline comments.
# Exported environment wins over .env. Image defaults come from manifest.json.
# DOCKER_REGISTRY=   # empty means no registry prefix
# DOCKER_USER=       # empty means no namespace
# DOCKER_IMAGE=unic-cass-tools
# DOCKER_TAG=1.3.0
PDK=ihp-sg13g2
# Absolute project path; spaces are accepted. Default: repository/shared_xserver.
# DESIGNS=/home/user/my designs
# SHARED_DIR is a legacy alias; differing explicit values are rejected.
# SHARED_DIR=/home/user/my designs
# Numeric host UID/GID by default (not upstream's root default).
# CONTAINER_USER=1000
# CONTAINER_GROUP=1000
# USER_ID / USER_GROUP are legacy aliases. ROOT=1 selects 0:0.
# CONTAINER_NAME=unic-cass-tools_custom
HTTP_PORT=8080
# WEBSERVER_PORT is the legacy alias, used only if HTTP_PORT is absent.
VNC_PORT=5901
JUPYTER_PORT=8888
# Ports bind to 127.0.0.1; 0 disables publication. Jupyter authentication retained.
# VNC requires an image built with ENABLE_GUI=1; never installs at launch.
ENABLE_GUI=
MAX_BUILD_JOBS=
BUILDKIT_PROGRESS=plain
BUILD_IMAGE_TAG=
STAGE=
NO_CACHE=
NO_PULL=
ROOT=
DRY_RUN=0
# DRY_RUN=1 prints escaped argv without Docker calls or host changes.
# DOCKER_EXTRA_PARAMS splits whitespace only; embedded quoting is not interpreted.
# Use launcher command argv for command arguments containing spaces.
# DISPLAY=:0
# XAUTHORITY=/home/user/.Xauthority
